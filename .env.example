# Copy to .env.local for local development and fill in your own values.
# Placeholders only — never commit real values. `.env`, `.env.local` and other local env files are gitignored.
#
# SECURITY: every VITE_* variable is compiled into the browser bundle and is PUBLIC.
# Only browser-safe configuration belongs here. Secrets (e.g. a Kinde client secret, M2M credentials)
# belong to the FastAPI backend and must never use a VITE_ prefix.

# ── API ──────────────────────────────────────────────────────────────────────
# FastAPI base URL (absolute http/https). Leave empty in dev to use the Vite /api proxy.
VITE_API_BASE_URL=
# Dev-only proxy target for /api (read by vite.config.ts).
VITE_API_PROXY_TARGET=

# ── Authentication (Kinde, browser SPA / PKCE — no client secret) ───────────
# "kinde" (default) or "dev". "dev" signs in as a local developer without Kinde and is
# ignored in production builds.
VITE_AUTH_MODE=
# Required: the Client ID of your Kinde "Front-end and mobile" application.
VITE_KINDE_CLIENT_ID=
# Required: your Kinde business domain, e.g. https://<your-business>.kinde.com
VITE_KINDE_DOMAIN=
# Optional: defaults to <current origin>/callback. Must be an Allowed callback URL in Kinde.
VITE_KINDE_REDIRECT_URI=
# Optional: defaults to <current origin>/login. Must be an Allowed logout redirect URL in Kinde.
VITE_KINDE_LOGOUT_URI=
# Optional: the API audience registered in Kinde for the FastAPI backend (needed for API access tokens).
VITE_KINDE_AUDIENCE=

# ── Vapi voice calling ───────────────────────────────────────────────────────
# PUBLIC key only (Vapi dashboard → API Keys → Public Key). Never put the private/server key here.
VITE_VAPI_PUBLIC_KEY=
# The Vapi assistant to call (Vapi dashboard → Assistants → ID).
VITE_VAPI_ASSISTANT_ID=

# ── Feature flags ────────────────────────────────────────────────────────────
VITE_FEATURE_CALLING=true
VITE_FEATURE_VOICE_NOTES=true
