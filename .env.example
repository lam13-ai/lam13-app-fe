# Copy to .env.local for local development and fill in your own values.
# Placeholders only — never commit real values. `.env`, `.env.local` and other local env files are gitignored.
#
# SECURITY: every VITE_* variable is compiled into the browser bundle and is PUBLIC.
# Only browser-safe configuration belongs here. Secrets belong to the FastAPI backend.

# ── API ──────────────────────────────────────────────────────────────────────
# LAM13 FastAPI backend (absolute http/https URL, no trailing path).
VITE_API_BASE_URL=http://localhost:8000

# ── Vapi voice calling (optional) ────────────────────────────────────────────
# PUBLIC key only (Vapi dashboard → API Keys → Public Key). Never put the private/server key here.
VITE_VAPI_PUBLIC_KEY=
# The Vapi assistant to call (Vapi dashboard → Assistants → ID).
VITE_VAPI_ASSISTANT_ID=

# ── Feature flags ────────────────────────────────────────────────────────────
# Voice notes need a backend /audio endpoint (not available yet). Calling needs the Vapi keys above.
VITE_FEATURE_CALLING=false
VITE_FEATURE_VOICE_NOTES=false
